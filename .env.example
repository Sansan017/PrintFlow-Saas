# PrintFlow SaaS — Contoh Environment
# Salin file ini menjadi `.env` dan isi dengan kredensial Supabase Anda.
# Jangan pernah menyimpan `.env` yang berisi secret ke repositori Git.

# URL proyek Supabase (publik, aman ditampilkan di browser).
# Contoh: https://<id-proyek>.supabase.co
VITE_SUPABASE_URL=

# Anon key Supabase (dirancang untuk dipakai di browser, bukan secret server).
# Tetap jangan menyebarluaskannya secara tidak perlu.
VITE_SUPABASE_ANON_KEY=

# Catatan:
# - SUPABASE_SERVICE_ROLE_KEY TIDAK boleh ada di frontend maupun .env ini.
#   Service-role key hanya boleh dipakai di lingkungan server/edge function.
